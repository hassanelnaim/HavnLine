# Copy to .env.local and fill in real values.
# The app runs and looks fully functional with NO values set — the
# dashboard reads from the mock data layer (lib/mock/) and auth pages
# show a clear "Supabase isn't connected" message instead of crashing.

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only — never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Used for auth redirect links, OAuth callbacks, and Twilio webhooks.
# Must be your real public site URL (e.g. https://yourapp.vercel.app),
# not localhost, for Google OAuth and Twilio to be able to reach you. ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude (the AI brain) ---
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=

# --- Google Calendar OAuth ---
# From Google Cloud Console -> APIs & Services -> Credentials.
# Redirect URI must exactly match what's registered there:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Twilio (real phone numbers, calls, SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Not yet implemented ---
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=

# --- Stripe (billing) ---
# One flat subscription — create one Product with one recurring Price
# in the Stripe Dashboard, then paste its Price ID here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint
STRIPE_WEBHOOK_SECRET=
