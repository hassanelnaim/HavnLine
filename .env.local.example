# Copy to .env.local and fill in real values.
# The app runs and looks fully functional with NO values set — the
# dashboard reads from the mock data layer (lib/mock/) and auth pages
# show a clear "Supabase isn't connected" message instead of crashing.

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only — never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Used for auth email redirect links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 integrations (not yet implemented, wired but unused) ---
# ANTHROPIC_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# VOICE_PROVIDER_API_KEY=
